# PostgreSQL
POSTGRES_DB=ragapp
POSTGRES_USER=ragapp
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://ragapp:replace-with-a-local-password@db:5432/ragapp

# Application
APP_ENV=development
APP_REVISION=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=ragapp
JWT_AUDIENCE=ragapp-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REGISTRATION_INVITATION_CODE=replace-with-a-private-invitation-code

# Authentication rate limits
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# Storage and worker
SOURCE_STORAGE_DIR=/app/storage/sources
WORKER_POLL_INTERVAL_SECONDS=30
JOB_LEASE_SECONDS=1200

# Document processing
UNSTRUCTURED_API_KEY=replace-with-unstructured-api-key
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
UNSTRUCTURED_STRATEGY=auto
UNSTRUCTURED_PDF_STRATEGY=hi_res
UNSTRUCTURED_OCR_LANGUAGES=eng
UNSTRUCTURED_POLL_INTERVAL_SECONDS=5
UNSTRUCTURED_JOB_TIMEOUT_SECONDS=900

# Gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=replace-with-gemini-api-key
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=replace-with-gemini-api-key
EMBEDDING_BATCH_SIZE=100
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=low
CHAT_MAX_OUTPUT_TOKENS=500

# Retrieval and experiments
RETRIEVAL_CANDIDATE_LIMIT=16
RETRIEVAL_RESULT_LIMIT=5
RETRIEVAL_MIN_SCORE=0.50
EXPERIMENT_MAX_CONTEXT_CHARS=24000
EXPERIMENT_VARIANT_CONCURRENCY=2
EXPERIMENT_CASE_CONCURRENCY=4
EXPERIMENT_EVALUATOR_CONCURRENCY=2
EXPERIMENT_PROVIDER_MAX_CONCURRENCY=4
EXPERIMENT_PROVIDER_REQUESTS_PER_MINUTE=60
EXPERIMENT_RUN_LEASE_SECONDS=900

# Optional production object storage
R2_ACCOUNT_ID=
R2_API=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional local pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password
PGADMIN_PORT=5050
